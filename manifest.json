{
  "manifest_version": 3,
  "name": "Joris Playlist Sorter for YouTube",
  "version": "1.2.0",
  "description": "Sorts the \"Save to playlist\" list and your channel Playlists tab A–Z, with a quick filter box.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
